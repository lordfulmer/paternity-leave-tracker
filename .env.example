# Copy this to .env.local and fill in your values

# Apps Script web app /exec URL (deploy from Apps Script editor)
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# API key — must match the API_KEY constant inside Code.gs
APPS_SCRIPT_API_KEY=CHANGE_ME_TO_LONG_RANDOM_STRING
